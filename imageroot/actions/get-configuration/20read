import json
import os
import sys

import agent
import termix_sso as sso

values = sso.read()
config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
    "PORT": values.get("PORT", "8080"),
    "oidc_mode": sso.mode(values),
    "oidc_provider": values.get(sso.PROVIDER, ""),
    "oidc_domain": values.get(sso.DOMAIN, ""),
    "oidc_secret_set": bool(values.get("OIDC_CLIENT_SECRET")),
    "oidc_legacy_callback": sso.enabled(values.get("OIDC_LEGACY_CALLBACK", "true")) and sso.mode(values) == "manual",
    "oidc_allow_password_login": sso.enabled(values.get(sso.PASSWORD_LOGIN, "true")),
    "oidc_silent_login": sso.enabled(values.get(sso.SILENT_LOGIN, "false")),
    "oidc_callback_path": sso.CALLBACK,
    "oidc_providers": [
        {key: data[key] for key in ("id", "label", "domains")}
        for data in sso.providers(agent.redis_connect()).values()
    ],
}
config.update({
    field: values.get(key) or default for field, (key, default) in sso.FIELDS.items()
    if field != "oidc_client_secret"
})
json.dump(config, fp=sys.stdout)
