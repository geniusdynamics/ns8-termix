import json
import sys

import termix_sso as sso

request = json.load(sys.stdin)
with sso.locked():
    previous = sso.read()
    try:
        settings = sso.configure(request, previous)
        sso.save(settings, previous)
    except sso.ConfigError as error:
        sso.report(error)
