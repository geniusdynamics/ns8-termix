#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later

import subprocess

import termix_sso as sso

with sso.locked():
    values = sso.read()
    values[sso.PASSWORD_LOGIN] = "true"
    values[sso.SILENT_LOGIN] = "false"
    sso.write(values)
    subprocess.run(["systemctl", "--user", "try-restart", "termix.service", "termix-app.service"], check=True)
print("Termix local password login enabled and silent SSO disabled")
